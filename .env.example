# =============================================================================
# Trellis Environment Configuration Template (.env.example)
# Copy to `.env` for local or production deployment. Never commit `.env`.
# =============================================================================

# 1. Mutually Exclusive Standalone Database Backend (Tier 0)
# Options: "memory" | "relational" | "graph"
DB_BACKEND=relational

# 2. Relational Backend Configuration (Adapter A: PostgreSQL / SQLite)
POSTGRES_USER=trellis
POSTGRES_PASSWORD=trellis
POSTGRES_DB=trellis
DATABASE_URL=sqlite:///trellis.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://trellis:trellis@localhost:5432/trellis

# 3. Graph Backend Configuration (Adapter B: Neo4j 5)
# Start with: docker compose --profile graph up
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trellis_graph_dev

# 4. API Security & CORS (Tier 9)
# Replace with a strong 32+ byte random secret in production
TRELLIS_JWT_SECRET=change-me-to-a-strong-random-secret
TRELLIS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 5. Constrained Direct-Instruction LLM (Tier 6)
# Leave GEMINI_API_KEY empty to fall back automatically to DeterministicMockLLMClient
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
